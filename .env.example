# Copy to .env (git-ignored) and fill in. Read by src/ms/common.py and src/ms/news.py (python-dotenv).

# --- API keys (free registration) ---
FRED_API_KEY=            # https://fred.stlouisfed.org/docs/api/api_key.html
EIA_API_KEY=             # https://www.eia.gov/opendata/register.php

# --- Contact e-mail for the SEC RSS feed (SEC requires it in the User-Agent; empty = SEC source disabled) ---
MS_CONTACT_EMAIL=

# --- launchd / scripts (macOS) — used by tools/jobctl.py render, tools/*.sh ---
# Label prefix for launchd jobs: <prefix>.snapshot, <prefix>.news, ...
MS_LAUNCHD_PREFIX=local.market-signals
# Absolute path of this repository (default: the directory containing tools/)
# MS_REPO=/path/to/market-signals
# uv binary (default: `uv` found on PATH; launchd has a minimal PATH, so the rendered plists pin this value)
# UV=/path/to/uv

# --- Optional overrides (defaults under data/) ---
# MS_DB=data/market.duckdb
# MS_VIEW_DB=data/market_view.duckdb
# MS_NEWS_VIEW_DB=data/news_view.duckdb
# MS_PAPER_DB=data/paper.duckdb
# GDELT_DB=data/gdelt.duckdb
# MS_OLLAMA_URL=http://127.0.0.1:11434      # must be loopback (enforced in src/ms/llm.py)
# MS_REQUIRE_DB=1                            # tests: fail instead of skip when data/market.duckdb is missing
